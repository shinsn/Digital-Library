@page
@model DigitalLibraryFinal.Pages.Books.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>📖 Details 📖</h1>

<div>
    <h4>About the Book</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Title
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.Title)
        </dd>
        <dt class="col-sm-2">
            Description
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.Description)
        </dd>
        <dt class="col-sm-2">
            Date of Publication
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.PublishDate)
        </dd>
        <dt class="col-sm-2">
            Published Under
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.PublisherName)
        </dd>
    </dl>
</div>
<div>

    <hr />
    <h2>@Model.Book.Title Genres</h2>
    <hr />
    <div class="d-flex flex-wrap gap-2">
        @foreach (var g in Model.Book.GenreNames)
        {
            <p class="border rounded px-3 py-1 bg-light text-dark mb-0">@g.GenreName</p>
        }
    </div>
    <p></p>

    <a asp-page="./Edit" asp-route-id="@Model.Book.Isbn" class="btn btn-outline-primary me-2">Edit</a>
    <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>

</div>
