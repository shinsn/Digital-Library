@page
@model DigitalLibraryFinal.Pages.Books.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Book</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Input.Isbn" class="control-label"></label>
                <input asp-for="Input.Isbn" class="form-control" />
                <span asp-validation-for="Input.Isbn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Title" class="control-label"></label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.PublisherName" class="control-label"></label>
                <select asp-for="Input.PublisherName" class="form-control" asp-items="ViewBag.PublisherName"></select>
            </div>


            <div class="form-group">
                <label asp-for="Input.Description" class="control-label"></label>
                <textarea asp-for="Input.Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.PublishDate" class="control-label"></label>
                <input asp-for="Input.PublishDate" class="form-control" />
                <span asp-validation-for="Input.PublishDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Authors</label>
                @foreach (var author in Model.Input.AllAuthors)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="@author.Value"
                               name="Input.SelectedAuthorIds"
                               checked="@Model.Input.SelectedAuthorIds.Contains(int.Parse(author.Value))" />
                        <label class="form-check-label">@author.Text</label>
                    </div>
                }
            </div>


            <div class="form-group">
                <label>Genres</label>
                @foreach (var genre in Model.Input.AllGenres)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="@genre.Value"
                               name="Input.SelectedGenreNames"
                               checked="@Model.Input.SelectedGenreNames.Contains(genre.Value)" />
                        <label class="form-check-label">@genre.Text</label>
                    </div>
                }
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
