@page
@model DigitalLibraryFinal.Pages.Authors.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete @Model.Author.AuthorName?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Author
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Author.AuthorName)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Author.AuthorId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
    </form>
</div>
