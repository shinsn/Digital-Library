@page
@model DigitalLibraryFinal.Pages.Publishers.DetailsModel

@{
    ViewData["Title"] = "Publisher Details";
}

<h1>Publisher: @Model.Publisher.PublisherName</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">
        Publisher
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(Model => Model.Publisher.PublisherName)
    </dd>
</dl>

<div class="mt-4">
    <a asp-page="./Edit" asp-route-id="@Model.Publisher.PublisherName" class="btn btn-outline-primary me-2">Edit</a>
    <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<hr />
<h2>Books Published Under @Model.Publisher.PublisherName</h2>
<hr />

<div class="container">
    <div class="row justify-content-start">
        @foreach (var b in Model.Books)
        {
            <div class="col-6 col-sm-4 col-md-3 col-lg-2 mb-4 d-flex flex-column align-items-center">
                <a asp-page="/Books/Details" asp-route-id="@b.Isbn" class="text-decoration-none text-dark w-100 d-flex flex-column align-items-center">
                    <!-- Book Shape -->
                    <div class="book-shape d-flex justify-content-center align-items-center">
                        <i class="bi bi-journal-bookmark-fill text-primary fs-3"></i>
                    </div>
                    <!-- Book Title -->
                    <div class="book-title text-center mt-2 w-100">
                        <strong>@b.Title</strong>
                    </div>
                </a>
            </div>
        }
    </div>
</div>
